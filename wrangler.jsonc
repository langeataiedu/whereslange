{
  // Where's Lange? Worker. Secrets (VIEWERS, UPDATE_SECRET) are set with `wrangler secret put`,
  // never written here. For local dev they come from .dev.vars (see .dev.vars.example).
  "name": "wheres-lange",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  // Old address, kept on only until the Apps Script posts to whereslange.com. Then set to false.
  "workers_dev": true,
  "preview_urls": false,
  // whereslange.com (and www) serve this Worker. Both sit behind the same Cloudflare Access application.
  "routes": [
    { "pattern": "whereslange.com", "custom_domain": true },
    { "pattern": "www.whereslange.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Run the Worker before serving any file, so every page and file requires a signed-in viewer.
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "STATUS", "id": "a21d9cc78e7e446ab8de7560a52ac0cf" }
  ],
  "vars": {
    // Cloudflare Access: the team domain and the Where's Lange application's AUD tag (not secret).
    "ACCESS_TEAM_DOMAIN": "https://crimson-cake-6b80.cloudflareaccess.com",
    "ACCESS_AUD": "b1bb011753509e50f7a89d574842d6c9b68ee84139f2875deabda8cbdab52dcb"
  }
}
